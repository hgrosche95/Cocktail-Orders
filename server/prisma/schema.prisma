generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  orderId     String    @id
  name        String
  items       Json
  note        String?
  // Reihenfolge der Warteschlange (Position beim Gast = Reihenfolge an der
  // Theke). Ohne ORDER BY garantiert Postgres keine Reihenfolge.
  createdAt   DateTime  @default(now())
  // Theke hat angefangen zu mixen (NULL = wartet noch). Ab dann kann der
  // Gast nicht mehr stornieren.
  startedAt   DateTime?
  // NULL = noch offen. War frueher ein harter DELETE beim Fertig-Markieren
  // (siehe app.js) - jetzt ein Soft-Complete, damit Bestellhistorie fuers
  // Rating/Empfehlungs-Feature erhalten bleibt.
  completedAt DateTime?

  // Zusaetzlich gibt es den partiellen Unique-Index
  // "orders_one_open_per_guest" (name WHERE completedAt IS NULL): hoechstens
  // eine offene Bestellung pro Gast. Prisma kann partielle Indizes nicht im
  // Schema abbilden, er steht nur in der Migration
  // 20261010120000_one_open_order_per_guest.

  @@map("orders")
}

model UnavailableIngredient {
  ingredient String @id

  @@map("unavailable_ingredients")
}

model Rating {
  id         String   @id @default(cuid())
  guestName  String
  // Kein Fremdschluessel: Cocktails sind statische Frontend-Daten
  // (src/data/cocktails.ts), nicht in der DB - cocktailId referenziert
  // deren Cocktail.id.
  cocktailId Int
  rating     Int
  updatedAt  DateTime @updatedAt

  @@unique([guestName, cocktailId])
  @@map("ratings")
}

// Drinks, die die Theke selbst angelegt hat. Die Grundkarte bleibt in
// shared/cocktails.json; menu.js fuegt beides zusammen. IDs starten bei
// 1001 (Sequenz in der Migration), die Grundkarte nutzt nur IDs < 1000.
model CustomCocktail {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Kategorie, Film, Beschreibung, Rezept - dieselbe Form wie ein Eintrag
  // in shared/cocktails.json (ohne id, name und die flache Zutatenliste).
  data      Json
  createdAt DateTime @default(now())

  @@map("custom_cocktails")
}
