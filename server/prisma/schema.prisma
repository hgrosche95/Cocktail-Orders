generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  orderId String  @id
  name    String
  items   Json
  note    String?

  @@map("orders")
}

model UnavailableIngredient {
  ingredient String @id

  @@map("unavailable_ingredients")
}
